import cv2
import random
import os
os.environ['TF_ENABLE_ONEDNN_OPTS'] = '0'  # Suppress TensorFlow warnings
from deepface import DeepFace

# 1. Camera Setup
cap = cv2.VideoCapture(0)
cap.set(cv2.CAP_PROP_FRAME_WIDTH, 640)
cap.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)

if not cap.isOpened():
    print("❌ Error: Could not access camera.")
    exit()

# 2. Mood Mapping: Base AI Emotions → Your 106 Nuanced Moods
# (Fixed typo: "Anoyed" → "Annoyed")
MOOD_MAP = {
    "happy": [
        "Ecstatic", "Elated", "Excited", "Cheerful", "Grateful", "Proud", "Content", 
        "Amused", "Vibrant", "Zealous", "Enthusiastic", "Giddy", "Jubilant", "Motivated", 
        "Playful", "Mischievous", "Whimsical", "Loved", "Compassionate", "Empathetic", 
        "Sympathetic", "Thankful", "Hopeful", "Optimistic", "Satisfied", "Eager", "Inspired"
    ],
    "sad": [
        "Sad", "Gloomy", "Melancholy", "Lonely", "Disappointed", "Heartbroken", "Devastated", 
        "Weary", "Bored", "Apathetic", "Dull", "Indifferent", "Resigned", "Guilty", 
        "Regretful", "Mournful", "Somber", "Grave", "Neglected", "Pessimistic", 
        "Exhausted", "Tired", "Lethargic", "Lazy"
    ],
    "angry": [
        "Angry", "Frustrated", "Irritated", "Annoyed", "Outraged", "Resentful", "Defiant", 
        "Rebellious", "Spiteful", "Vengeful", "Stressed", "Overwhelmed", "Restless", 
        "Tense", "Hysterical", "Jealous", "Envious"
    ],
    "fear": [
        "Anxious", "Panicked", "Terrified", "Scared", "Fearful", "Nervous", "Worried", 
        "Uneasy", "Wary", "Intimidated", "Paranoid", "Obsessive", "Hesitant", 
        "Insecure", "Vulnerable", "Inhibited", "Shocked"
    ],
    "surprise": [
        "Surprised", "Perplexed", "Confused", "Intrigued", "Curious", "Astonished", 
        "Startled", "Bewildered", "Dazed", "Awkward"
    ],
    "disgust": [
        "Disgusted", "Repulsed", "Cynical", "Sarcastic", "Skeptical", "Suspicious", 
        "Apathetic", "Indifferent"
    ],
    "neutral": [
        "Calm", "Peaceful", "Relaxed", "Serene", "Pensive", "Solemn", "Restorative", 
        "Reverent", "Contemplative", "Quiet", "Balanced", "Focused", "Observant", 
        "Reflective", "Bittersweet", "Nostalgic", "Wistful"
    ]
}

# Verify count (should be 106)
all_moods = [mood for sublist in MOOD_MAP.values() for mood in sublist]
print(f"Loaded {len(all_moods)} nuanced moods. (Base AI detects 7 core emotions)")

# 3. Runtime Variables
frame_count = 0
ANALYZE_INTERVAL = 12
current_base = "Initializing..."
suggested_moods = ["...", "...", "..."]
confidence = 0.0
face_bbox = None

print("🎥 Starting 106-Mood Detector. Press 'q' to quit.")

while True:
    ret, frame = cap.read()
    if not ret:
        print("Failed to capture frame.")
        break

    frame_count += 1

    # Analyze every N frames
    if frame_count % ANALYZE_INTERVAL == 0:
        try:
            analysis = DeepFace.analyze(
                frame,
                actions=['emotion'],
                enforce_detection=False,
                detector_backend='opencv'
            )
            
            if analysis:
                result = analysis[0]
                emotions = result['emotion']
                current_base = result['dominant_emotion'].capitalize()
                confidence = emotions[current_base.lower()]
                
                # Pick 3 nuanced moods from the detected category
                category = current_base.lower()
                if category in MOOD_MAP:
                    suggested_moods = random.sample(MOOD_MAP[category], min(3, len(MOOD_MAP[category])))
                else:
                    suggested_moods = ["Neutral", "Calm", "Reflective"]
                    
                # Extract face region
                region = result.get('region', {})
                face_bbox = (region['x'], region['y'], 
                             region['x'] + region['w'], 
                             region['y'] + region['h']) if region else None
            else:
                current_base = "No Face"
                suggested_moods = ["...", "...", "..."]
                confidence = 0.0
                face_bbox = None
        except Exception as e:
            print(f" Analysis error: {e}")

    # Draw UI Elements
    if face_bbox:
        cv2.rectangle(frame, (face_bbox[0], face_bbox[1]), 
                      (face_bbox[2], face_bbox[3]), (0, 255, 0), 2)

    # Base Emotion & Confidence
    cv2.putText(frame, f"Base: {current_base} ({confidence:.1f}%)", (20, 40), 
                cv2.FONT_HERSHEY_SIMPLEX, 0.9, (255, 255, 255), 2)

    # Suggested Nuanced Moods
    for i, mood in enumerate(suggested_moods):
        y_pos = 70 + (i * 25)
        cv2.putText(frame, f"• {mood}", (20, y_pos), 
                    cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 255, 200), 2)

    cv2.imshow('106-Mood Detection', frame)

    # Exit on 'q' or Esc
    key = cv2.waitKey(1) & 0xFF
    if key in [ord('q'), 27]:
        break

# Cleanup
cap.release()
cv2.destroyAllWindows()
print(" Detection stopped.")
